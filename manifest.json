{
  "manifest_version": 3,
  "name": "WebCaptrue",
  "version": "0.2.0",
  "description": "One-click offline web capture for later AI-assisted analysis. Chrome 109+ compatible.",
  "minimum_chrome_version": "109",
  "permissions": [
    "debugger",
    "scripting",
    "storage",
    "downloads",
    "tabs",
    "webNavigation",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "WebCaptrue",
    "default_popup": "popup.html"
  },
  "commands": {
    "toggle-capture": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "MacCtrl+Shift+Y"
      },
      "description": "开始完整采集或停止并导出 ZIP"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/lib/sanitize.js",
        "src/content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
